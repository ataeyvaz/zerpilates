    aiImagePrompt: 'woman doing Pilates push-up after roll-down, in plank lowering gracefully, dynamic shot',
  },
];

// Helper maps for quick access
export const EXERCISE_MAP: Record<string, Exercise> = Object.fromEntries(
  EXERCISES.map((e) => [e.id, e])
);
